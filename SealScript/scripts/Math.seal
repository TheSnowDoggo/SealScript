#no_terminators
class Math {
    static func is_prime(x: Number) {
        if x == 2 {
            return true
        }
        if x <= 1 or (x & 1) == 0 {
            return false
        }
        
        var end = floor(sqrt(x))
        
        for i in range(3, end + 1, 2) {
            if x % i == 0 {
                return false
            }
        }
        
        return true
    }
}
return Math