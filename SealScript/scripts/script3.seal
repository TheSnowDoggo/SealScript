#no_terminators

var Foo: Class = class Foo {
    const id // Const Variables and Fields do not specify types (as they are immutable)
    var name: String
    
    constructor(id: Number) {
        self.id = id // Const fields can be set in a constructor
    }
}

var obj = Foo.new(3)

obj.name = "hello" // fine
obj.name = 4 // Error at 15:0 Field Foo.name expected value of type String, got Number.
obj.id = 3 // Error at 16:0 Cannot set field Foo.id as it is immutable.